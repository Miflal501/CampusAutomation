# This is what inventory/hosts.yml looks like after generation - checked
# in as a reference only. The real file is generated by
# scripts/generate_inventory.py from devices.yaml (which holds the real
# IPs/credentials) and is gitignored since it contains live creds.
#
# Generate it with:
#   python3 scripts/generate_inventory.py
---
all:
  children:
    distribution:
      hosts:
        SW-D-DEIE:
          ansible_host: 10.99.99.11
          ansible_user: admin
          ansible_password: "<from devices.yaml>"
          ansible_become: true
          ansible_become_password: "<from devices.yaml>"
        SW-D-DCEE: { ... }
        SW-D-DMME: { ... }
    access:
      hosts:
        SW-A-DEIE: { ... }
        SW-A-DCEE: { ... }
        SW-A-DMME: { ... }
        SW-A-DIS: { ... }
    switches:
      children:
        distribution:
        access:
